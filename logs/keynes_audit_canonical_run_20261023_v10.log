KeynesI.th_12_i : ∀ (a b h : KeynesI.IProp),
  KeynesI.Cons h → KeynesI.PrI (KeynesI.iiff a b) h = 1 → KeynesI.PrI a h = KeynesI.PrI b h
KeynesI.th_12_i_short : ∀ (a b h : KeynesI.IProp),
  KeynesI.Cons h → KeynesI.PrI (KeynesI.iiff a b) h = 1 → KeynesI.PrI a h = KeynesI.PrI b h
KeynesI.subst_taut : ∀ (f g : KeynesI.Form) (env : ℕ → KeynesI.IProp) (h : KeynesI.IProp),
  KeynesI.Cons h → KeynesI.Taut (f.iffF g) → KeynesI.PrI (KeynesI.interp env f) h = KeynesI.PrI (KeynesI.interp env g) h
KeynesI.itrue_certain : ∀ (h : KeynesI.IProp), KeynesI.Cons h → KeynesI.PrI KeynesI.itrue h = 1
KeynesI.th_13_1_i : ∀ (a h : KeynesI.IProp), KeynesI.Cons h → KeynesI.PrI a h + KeynesI.PrI (KeynesI.inot a) h = 1
KeynesI.th_24_i : ∀ (a b h : KeynesI.IProp),
  KeynesI.Cons h →
    KeynesI.PrI (KeynesI.ior a b) h = KeynesI.PrI a h + KeynesI.PrI b h - KeynesI.PrI (KeynesI.iand a b) h
KeynesI.th_14_36_i : ∀ (a b h : KeynesI.IProp),
  KeynesI.PrI a (KeynesI.iand b h) = KeynesI.PrI a h →
    KeynesI.PrI (KeynesI.iand a b) h = KeynesI.PrI a h * KeynesI.PrI b h
KeynesI.th_14_38_full_i : ∀ (a b h : KeynesI.IProp),
  KeynesI.PrI b h ≠ 0 →
    KeynesI.PrI a (KeynesI.iand b h) = KeynesI.PrI b (KeynesI.iand a h) * KeynesI.PrI a h / KeynesI.PrI b h
KeynesI.th_13_13_conj_i : ∀ (a h : KeynesI.IProp),
  KeynesI.Cons h → KeynesI.Cons (KeynesI.iand a h) → KeynesI.PrI a (KeynesI.iand a h) = 1
