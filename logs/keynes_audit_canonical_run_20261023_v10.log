Keynes.th_13_4 : ∀ (α b h : Prop), Keynes.Pr (α ∧ b) h ≤ Keynes.Pr b h
Keynes.th_13_12 : ∀ (α b h : Prop), Keynes.Pr (α ↔ b) h = 1 → Keynes.Pr α h = Keynes.Pr b h
Keynes.th_13_13 : ∀ (α h : Prop), Keynes.Pr α h ≠ 0 → Keynes.Pr α (α ∧ h) = 1
Keynes.th_13_18 : ∀ (α h : Prop), Keynes.Pr α (α ∧ h) = 1 ∨ Keynes.Pr (¬α) (¬α ∧ h) = 1
Keynes.th_13_21 : ∀ (α h₁ h₂ h : Prop), Keynes.Pr α (h₁ ∧ h) = 1 → Keynes.Pr α (h₂ ∧ h) = 0 → Keynes.Pr (h₁ ∧ h₂) h = 0
Keynes.th_14_24_6 : ∀ (h : Prop) (l : List Prop),
  List.Pairwise (fun a b => Keynes.Pr (a ∧ b) h = 0) l → Keynes.Pr (Keynes.bigOr l) h = Keynes.sumPr l h
Keynes.th_14_26 : ∀ (α h : Prop), Keynes.Pr h h = 1 → Keynes.Pr (α ∧ h) h = Keynes.Pr α h
Keynes.th_14_29 : ∀ (α h₁ h₂ h : Prop),
  Keynes.Pr α ((h₁ ∨ h₂) ∧ h) = 1 →
    Keynes.Pr h₁ ((h₁ ∨ h₂) ∧ h) ≠ 0 →
      Keynes.Pr h₂ ((h₁ ∨ h₂) ∧ h) ≠ 0 → Keynes.Pr α (h₁ ∧ h) = 1 ∧ Keynes.Pr α (h₂ ∧ h) = 1
Keynes.th_14_31 : ∀ (α₁ α₂ h : Prop),
  Keynes.Pr α₂ (α₁ ∧ h) = Keynes.Pr α₂ h → Keynes.Pr α₂ h ≠ 0 → Keynes.Pr α₁ (α₂ ∧ h) = Keynes.Pr α₁ h
Keynes.th_14_32 : ∀ (α h₁ h : Prop),
  0 < Keynes.Pr α h → 0 < Keynes.Pr h₁ h → Keynes.Pr α h < Keynes.Pr α (h₁ ∧ h) → Keynes.Pr h₁ h < Keynes.Pr h₁ (α ∧ h)
Keynes.th_14_37_full : ∀ (h : Prop) (v : ℝ) (l : List Prop),
  (∀ p ∈ l, ∀ (e : Prop), Keynes.Pr p e = v) → Keynes.Pr (Keynes.bigAnd l) h = v ^ l.length
Keynes.th_14_41_2 : ∀ (l : List Prop) (h : Prop),
  Keynes.prodPr l h ≠ 0 → Keynes.Pr (Keynes.bigAnd l) h = Keynes.InflN l h * Keynes.prodPr l h
